# Copy to .env and fill in what you have. Everything here is optional — the app runs
# fully functional in demo mode with none of it set.

# Shared secret the webhook expects in the X-Webhook-Secret header. Change this before
# deploying anywhere public.
WEBHOOK_SHARED_SECRET=changeme-dev-secret

# How many minutes count as "the same alert" for deduplication.
DEDUP_WINDOW_MINUTES=15

# Real IP reputation lookups. Free tier key at https://www.abuseipdb.com/account/api
# Without this, enrichment uses a deterministic mock (still fully functional, just not
# real threat intel).
ABUSEIPDB_API_KEY=

# Real Slack delivery. Create an "Incoming Webhook" in a Slack app and paste the URL.
# Without this, the app logs what it *would* have posted instead.
SLACK_WEBHOOK_URL=

# Real Jira ticket creation. Without all four of these, the app logs what it *would*
# have created instead.
JIRA_BASE_URL=
JIRA_EMAIL=
JIRA_API_TOKEN=
JIRA_PROJECT_KEY=

# Where the SQLite file lives.
DATABASE_PATH=./data/alerts.db
